# Glogovet Trails – cPanel / Apache config

# Serve index.html when someone visits the bare domain
DirectoryIndex index.html

# Make sure pages are served as web pages (never shown as raw text / downloaded)
AddType text/html .html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/x-icon .ico

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html  ->  /   (clean link, no ".html" in the address bar)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # /page.html  ->  /page   (for any future pages)
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /page  ->  serves page.html internally
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
